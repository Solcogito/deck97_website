---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dispositions, loop, site } from '../data/site';
import heroSource from '../assets/hero-station.png';
import objectCupSource from '../assets/object-last-cup.png';
import caseSeedSource from '../assets/case-seed-jar.png';
import fieldStationSource from '../assets/field-station.png';
import fieldDeskSource from '../assets/field-desk.png';
import fieldShiftSource from '../assets/field-shift.png';
import fieldClaimsSource from '../assets/field-claims.png';

const dispositionNotes = [
  'Return to a verified claimant',
  'Retain pending further evidence',
  'Preserve as institutional record',
  'Release through public disposition',
  'Remove from circulation',
  'Send beyond your authority',
];

const gallery = [
  { src: fieldStationSource, alt: 'DECK 97 visual development view across the Lost Property Division workstation.' },
  { src: fieldDeskSource, alt: 'DECK 97 visual development view of the inspection desk and station interior.' },
  { src: fieldClaimsSource, alt: 'DECK 97 visual development showing a claimant message and evidence interface around an object.' },
  { src: fieldShiftSource, alt: 'DECK 97 visual development view of the night-shift workstation.' },
];
---
<BaseLayout>
  <header class="site-header">
    <div class="shell header-row">
      <a class="wordmark" href="#top" aria-label="DECK 97 home">DECK 97</a>
      <div class="header-meta">
        <span>LOST PROPERTY DIVISION</span>
        <nav class="header-nav" aria-label="Primary navigation">
          <a href="#object">Object</a>
          <a href="#process">Process</a>
          <a href="#station">Station A</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <Image src={heroSource} width={1279} alt="" format="webp" quality={78} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="shell hero-inner">
        <p class="micro hero-kicker">Station A / Deck 97 / Night Intake</p>
        <h1 id="hero-title">DECK 97</h1>
        <p class="hero-tagline">A civilization is what it refuses to throw away.</p>
        <p class="hero-pitch">Inspect disputed objects. Uncover their histories. Decide what civilization keeps.</p>
        <div class="hero-actions">
          {site.steamUrl ? (
            <a class="cta" href={site.steamUrl} rel="noreferrer">Wishlist on Steam</a>
          ) : (
            <span class="cta cta--disabled" aria-label="DECK 97 is coming to Steam">Coming to Steam</span>
          )}
          <a class="cta cta--ghost" href="#object">Begin inspection</a>
        </div>
        <div class="hero-register" aria-label="Game information">
          <div><strong>SHIFT</strong><span>Night</span></div>
          <div><strong>PLATFORM</strong><span>{site.platform}</span></div>
          <div><strong>STATUS</strong><span>{site.releaseState}</span></div>
        </div>
      </div>
      <p class="hero-caption">DECK 97 visual development / imagery subject to change</p>
    </section>

    <section class="section section--object" id="object" aria-labelledby="object-title">
      <div class="shell">
        <div class="section-head">
          <p class="micro section-number">01 / THE OBJECT</p>
          <div>
            <h2 class="section-title" id="object-title">Every shift begins with an object.</h2>
            <p class="section-intro">At first, it may be ordinary. Turn it over. Open it. Measure it. Read the repair. Follow the residue. The object is not a prop — it is the first witness.</p>
          </div>
        </div>
        <div class="object-grid">
          <figure class="media-frame media-frame--reference">
            <Image src={objectCupSource} width={1100} alt="Authored DECK 97 reference for The Last Cup, a worn transit cup with repair and ownership evidence." format="webp" quality={80} loading="lazy" decoding="async" />
            <figcaption class="media-label">AUTH-002 / THE LAST CUP / authored object development</figcaption>
          </figure>
          <aside class="object-card" aria-label="Example intake record">
            <div>
              <p class="micro">Lost Property Division / Intake</p>
              <p class="object-id">AUTH—002</p>
              <p>No answer arrives with the object. Only evidence does. Wear, repair, material, route records and competing claims can agree — or fail to.</p>
            </div>
            <dl class="measurements">
              <div><dt>ORIGIN</dt><dd>UNRESOLVED</dd></div>
              <div><dt>CLAIMANTS</dt><dd>DISPUTED</dd></div>
              <div><dt>HISTORY</dt><dd>INCOMPLETE</dd></div>
              <div><dt>DISPOSITION</dt><dd>PENDING</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="section section--process" id="process" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-head">
          <p class="micro section-number">02 / PROCEDURE</p>
          <div>
            <h2 class="section-title" id="process-title">The history is not given to you. You reconstruct it.</h2>
            <p class="section-intro">Physical evidence leads outward: from the desk, to archives and claims, then back to a decision you have to own.</p>
          </div>
        </div>
        <div class="loop-track" aria-label="DECK 97 gameplay loop">
          {loop.map((step, index) => (
            <div class="loop-row">
              <span class="loop-index">0{index + 1}</span>
              <strong class="loop-name">{step}</strong>
              <span class="loop-arrow" aria-hidden="true">{index < loop.length - 1 ? '↓' : '•'}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--decision" aria-labelledby="decision-title">
      <div class="shell">
        <div class="section-head">
          <p class="micro section-number">03 / DISPOSITION</p>
          <div><h2 class="section-title" id="decision-title">Evidence can be factual. A decision can still be difficult.</h2></div>
        </div>
        <div class="decision-panel">
          <div class="decision-copy">
            <p class="micro">Authorized actions</p>
            <h3>What happens to it?</h3>
            <p>Classification is not decoration. A choice can return an object to a person, hold it away from them, preserve it for a civilization — or erase it from circulation.</p>
          </div>
          <div class="decision-grid">
            {dispositions.map((item, index) => (
              <div class="disposition"><strong>{item}</strong><span>{dispositionNotes[index]}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section section--world" id="station" aria-labelledby="world-title">
      <div class="shell world-grid">
        <div>
          <p class="micro section-number">04 / STATION A</p>
          <blockquote class="world-quote" id="world-title">The universe is enormous. Your desk is not.</blockquote>
        </div>
        <div class="world-copy">
          <p>You work the night shift in the Lost Property Division of an ancient interstellar transit station. The playable space stays small. The world enters through what people leave behind.</p>
          <p>A mundane object can expose a family, an institution, a jurisdiction, a culture, a forgotten event — or two incompatible versions of the same history.</p>
          <ul class="world-list" aria-label="What objects can reveal">
            <li>People</li><li>Institutions</li><li>Jurisdictions</li><li>Cultures</li><li>Conflicts</li><li>Forgotten events</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--gallery" aria-labelledby="gallery-title">
      <div class="shell">
        <div class="section-head">
          <p class="micro section-number">05 / FIELD RECORDS</p>
          <div><h2 class="section-title" id="gallery-title">One room. One desk. A civilization passing through it.</h2></div>
        </div>
        <div class="gallery-grid">
          {gallery.map((item, index) => (
            <button class={`gallery-item gallery-item--${index + 1}`} type="button" data-gallery-alt={item.alt} aria-label={`Open DECK 97 visual ${index + 1}`}>
              <Image src={item.src} width={1080} alt={item.alt} format="webp" quality={72} loading="lazy" decoding="async" />
              <span class="gallery-mark">D97 / {String(index + 1).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
        <p class="gallery-note">Current DECK 97 visual development material. Presentation and assets may evolve during production.</p>
      </div>
    </section>

    <section class="section section--case" aria-labelledby="case-title">
      <div class="shell">
        <div class="section-head case-head">
          <p class="micro section-number">06 / CASE FILE</p>
          <div>
            <p class="micro case-id">AUTH-011 / THE SEED JAR</p>
            <h2 class="section-title" id="case-title">Three claims. One object. No uncontested history.</h2>
          </div>
        </div>
        <div class="case-grid">
          <figure class="case-visual">
            <Image src={caseSeedSource} width={760} alt="Authored DECK 97 reference board for The Seed Jar, a sealed specimen jar containing the Sable-19 cultivar." format="webp" quality={80} loading="lazy" decoding="async" />
            <figcaption class="media-label">AUTH-011 / authored case material</figcaption>
          </figure>
          <div class="case-record">
            <dl class="case-facts">
              <div><dt>CULTIVAR</dt><dd>SABLE-19</dd></div>
              <div><dt>EST. SEEDS</dt><dd>214</dd></div>
              <div><dt>EST. VIABILITY</dt><dd>63%</dd></div>
            </dl>
            <div class="claim-list" aria-label="Competing claims">
              <div><span>RUUN VALE</span><strong>Private restitution</strong></div>
              <div><span>COMMON SEED TRUST</span><strong>Mandatory duplication</strong></div>
              <div><span>PALISADE</span><strong>Biosecurity restriction</strong></div>
            </div>
            <p class="case-question">Which claim survives disposition?</p>
            <div class="case-actions" aria-label="Possible dispositions">
              <span>RETURN</span><span>HOLD</span><span>ARCHIVE</span><span>ESCALATE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="shell">
        <p class="micro">Lost Property Division / Final disposition pending</p>
        <h2 id="final-title">A civilization is what it refuses to throw away.</h2>
        <p>DECK 97 is a premium PC game in development. Inspect the object. Establish what happened. Decide where it belongs.</p>
        <div class="hero-actions">
          {site.steamUrl ? (
            <a class="cta" href={site.steamUrl} rel="noreferrer">Wishlist on Steam</a>
          ) : (
            <span class="cta cta--disabled" aria-label="DECK 97 is coming to Steam">Coming to Steam</span>
          )}
          {site.kickstarterUrl && <a class="cta cta--ghost" href={site.kickstarterUrl} rel="noreferrer">Follow the Kickstarter</a>}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-row">
      <div class="footer-brand"><strong>DECK 97</strong><span>A Solcogito game</span></div>
      <div class="footer-links">
        {site.contactUrl && <a href={site.contactUrl}>Contact</a>}
        {site.socialUrls.map((social) => <a href={social.url} rel="noreferrer">{social.label}</a>)}
      </div>
      <p class="footer-copy">© 2026 Solcogito. All rights reserved.</p>
    </div>
  </footer>

  <dialog class="image-dialog" id="image-dialog" aria-label="Expanded DECK 97 visual">
    <div class="dialog-inner">
      <img id="dialog-image" src="" alt="" />
      <button class="dialog-close" type="button" aria-label="Close image">CLOSE</button>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
    const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
    const closeButton = document.querySelector<HTMLButtonElement>('.dialog-close');

    document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !dialogImage) return;
        const image = button.querySelector<HTMLImageElement>('img');
        dialogImage.src = image?.currentSrc || image?.src || '';
        dialogImage.alt = button.dataset.galleryAlt ?? 'DECK 97 visual development image.';
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>
