---
const title = 'DECK 97 — A civilization is what it refuses to throw away.';
const description = 'Inspect disputed objects, uncover their histories, and decide what civilization keeps in DECK 97.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://deck97game.com/" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="shell">
        <p class="eyebrow">STATION A / INTAKE</p>
        <h1>DECK 97</h1>
        <h2>A civilization is what it refuses to throw away.</h2>
        <p>Inspect disputed objects. Uncover their histories. Decide what civilization keeps.</p>
        <p class="status">Website foundation ready. Final art direction and media pass pending source assets.</p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { color-scheme: dark; background: #11110f; }
  :global(body) { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #11110f; color: #ece9df; }
  main { min-height: 100svh; display: grid; place-items: center; padding: 2rem; }
  .shell { width: min(860px, 100%); border-top: 1px solid #77736b; border-bottom: 1px solid #35332f; padding: clamp(2rem, 7vw, 6rem) 0; }
  .eyebrow, .status { font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; color: #99948a; }
  h1 { margin: .7rem 0 0; font-size: clamp(4rem, 15vw, 9rem); line-height: .83; letter-spacing: -.06em; }
  h2 { max-width: 700px; margin: 2rem 0 1rem; font-weight: 500; font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: 1.05; }
  p { max-width: 650px; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.6; }
  .status { margin-top: 3rem; font-size: .68rem; }
</style>
