---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getCopy, type Locale } from '../data/copy';
import heroSource from '../assets/hero-gameplay.webp';
import objectCupSource from '../assets/object-last-cup.png';
import caseSeedSource from '../assets/case-seed-jar.png';
import galleryDeskWide from '../assets/gallery-desk-wide.webp';
import galleryStationView from '../assets/gallery-station-view.webp';
import galleryDeskNight from '../assets/gallery-desk-night.webp';
import visualDevCutaway from '../assets/visual-dev-cutaway.webp';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getCopy(locale);
const isFrench = locale === 'fr';
const alternateHref = isFrench ? '/' : '/fr/';
const gallerySources = [galleryDeskWide, galleryStationView, galleryDeskNight, visualDevCutaway];
---
<BaseLayout lang={locale} title={t.meta.title} description={t.meta.description} alternateHref={alternateHref} alternateLang={isFrench ? 'en' : 'fr'}>
  <span slot="skip">{t.accessibility.skip}</span>

  <header class="site-header">
    <div class="shell header-row">
      <a class="wordmark" href="#top" aria-label="DECK 97 home">DECK 97</a>
      <div class="header-meta">
        <span>{t.header.division}</span>
        <nav class="header-nav" aria-label={t.accessibility.nav}>
          <a href="#object">{t.header.object}</a>
          <a href="#process">{t.header.process}</a>
          <a href="#station">{t.header.station}</a>
          <a href="#project">{t.header.project}</a>
        </nav>
        <a class="language-switch" href={alternateHref} hreflang={isFrench ? 'en' : 'fr'} aria-label={t.header.languageLabel}>{t.header.language}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <Image src={heroSource} width={1149} alt="" format="webp" quality={90} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="shell hero-inner">
        <p class="micro hero-kicker">{t.hero.kicker}</p>
        <h1 id="hero-title">DECK 97</h1>
        <p class="hero-tagline">{t.hero.tagline}</p>
        <p class="hero-pitch">{t.hero.pitch}</p>
        <div class="hero-actions">
          {site.steamUrl ? <a class="cta" href={site.steamUrl} rel="noreferrer">{t.hero.steam}</a> : <span class="cta cta--disabled">{t.hero.steamPending}</span>}
          <a class="cta cta--ghost" href="#object">{t.hero.begin}</a>
        </div>
        <div class="hero-register" aria-label={t.accessibility.gameInfo}>
          <div><strong>{t.hero.shiftLabel}</strong><span>{t.hero.shift}</span></div>
          <div><strong>{t.hero.platformLabel}</strong><span>{t.hero.platform}</span></div>
          <div><strong>{t.hero.statusLabel}</strong><span>{t.hero.status}</span></div>
        </div>
        <p class="hero-origin">{t.hero.origin}</p>
      </div>
      <p class="hero-caption">{t.hero.caption}</p>
    </section>

    <section class="section section--object" id="object" aria-labelledby="object-title">
      <div class="shell">
        <div class="section-head"><p class="micro section-number">{t.object.number}</p><div><h2 class="section-title" id="object-title">{t.object.title}</h2><p class="section-intro">{t.object.intro}</p></div></div>
        <div class="object-grid">
          <figure class="media-frame media-frame--reference"><Image src={objectCupSource} width={1100} alt="DECK 97 authored object reference." format="webp" quality={80} loading="lazy" decoding="async" /><figcaption class="media-label">{t.object.mediaLabel}</figcaption></figure>
          <aside class="object-card"><div><p class="micro">{t.object.intake}</p><p class="object-id">AUTH—002</p><p>{t.object.body}</p></div><dl class="measurements">{t.object.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></aside>
        </div>
      </div>
    </section>

    <section class="section section--process" id="process" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-head"><p class="micro section-number">{t.process.number}</p><div><h2 class="section-title" id="process-title">{t.process.title}</h2><p class="section-intro">{t.process.intro}</p></div></div>
        <div class="loop-track">{t.process.loop.map((step, index) => <div class="loop-row"><span class="loop-index">0{index + 1}</span><strong class="loop-name">{step}</strong><span class="loop-arrow" aria-hidden="true">{index < t.process.loop.length - 1 ? '↓' : '•'}</span></div>)}</div>
      </div>
    </section>

    <section class="section section--decision" aria-labelledby="decision-title">
      <div class="shell">
        <div class="section-head"><p class="micro section-number">{t.decision.number}</p><div><h2 class="section-title" id="decision-title">{t.decision.title}</h2></div></div>
        <div class="decision-panel"><div class="decision-copy"><p class="micro">{t.decision.authorized}</p><h3>{t.decision.question}</h3><p>{t.decision.body}</p></div><div class="decision-grid">{t.decision.dispositions.map(([name, note]) => <div class="disposition"><strong>{name}</strong><span>{note}</span></div>)}</div></div>
      </div>
    </section>

    <section class="section section--world" id="station" aria-labelledby="world-title">
      <div class="shell world-grid"><div><p class="micro section-number">{t.world.number}</p><blockquote class="world-quote" id="world-title">{t.world.quote}</blockquote></div><div class="world-copy">{t.world.paragraphs.map((p) => <p>{p}</p>)}<ul class="world-list">{t.world.records.map((item) => <li data-record={t.world.recordLabel}>{item}</li>)}</ul></div></div>
    </section>

    <section class="section section--project" id="project" aria-labelledby="project-title">
      <div class="shell">
        <div class="section-head"><p class="micro section-number">{t.project.number}</p><div><h2 class="section-title" id="project-title">{t.project.title}</h2><p class="section-intro">{t.project.intro}</p></div></div>
        <div class="project-grid">
          <div class="project-copy"><p>{t.project.ai}</p><p>{t.project.intent}</p></div>
          <div class="principles">{t.project.principles.map(([title, body]) => <div class="principle"><strong>{title}</strong><p>{body}</p></div>)}</div>
        </div>
      </div>
    </section>

    <section class="section section--gallery" aria-labelledby="gallery-title">
      <div class="shell">
        <div class="section-head"><p class="micro section-number">{t.gallery.number}</p><div><h2 class="section-title" id="gallery-title">{t.gallery.title}</h2></div></div>
        <div class="gallery-grid">{gallerySources.map((src, index) => <button class={`gallery-item gallery-item--${index + 1}`} type="button" data-gallery-alt={t.gallery.alts[index]} aria-label={`${t.accessibility.gallery} ${index + 1}`}><Image src={src} width={1160} alt={t.gallery.alts[index]} format="webp" quality={88} loading="lazy" decoding="async" /><span class="gallery-mark">D97 / {String(index + 1).padStart(2, '0')}</span></button>)}</div>
        <p class="gallery-note">{t.gallery.note}</p>
      </div>
    </section>

    <section class="section section--case" aria-labelledby="case-title">
      <div class="shell">
        <div class="section-head case-head"><p class="micro section-number">{t.caseFile.number}</p><div><p class="micro case-id">{t.caseFile.id}</p><h2 class="section-title" id="case-title">{t.caseFile.title}</h2></div></div>
        <div class="case-grid"><figure class="case-visual"><Image src={caseSeedSource} width={760} alt="DECK 97 authored case reference." format="webp" quality={80} loading="lazy" decoding="async" /><figcaption class="media-label">{t.caseFile.mediaLabel}</figcaption></figure><div class="case-record"><dl class="case-facts">{t.caseFile.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><div class="claim-list" aria-label={t.accessibility.claims}>{t.caseFile.claims.map(([claimant, claim]) => <div><span>{claimant}</span><strong>{claim}</strong></div>)}</div><p class="case-question">{t.caseFile.question}</p><div class="case-actions" aria-label={t.accessibility.actions}>{t.caseFile.actions.map((action) => <span>{action}</span>)}</div></div></div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title"><div class="shell"><p class="micro">{t.final.micro}</p><h2 id="final-title">{t.final.title}</h2><p>{t.final.body}</p><div class="hero-actions">{site.steamUrl ? <a class="cta" href={site.steamUrl} rel="noreferrer">{t.hero.steam}</a> : <span class="cta cta--disabled">{t.hero.steamPending}</span>}{site.kickstarterUrl && <a class="cta cta--ghost" href={site.kickstarterUrl} rel="noreferrer">{t.final.kickstarter}</a>}</div></div></section>
  </main>

  <footer class="site-footer"><div class="shell footer-row"><div class="footer-brand"><strong>DECK 97</strong><span>{t.footer.studio}</span></div><div class="footer-links">{site.contactUrl && <a href={site.contactUrl}>{t.footer.contact}</a>}{site.socialUrls.map((social) => <a href={social.url} rel="noreferrer">{social.label}</a>)}</div><p class="footer-copy">© 2026 Solcogito. {t.footer.rights}</p></div></footer>

  <dialog class="image-dialog" id="image-dialog" aria-label={t.accessibility.dialog}><div class="dialog-inner"><img id="dialog-image" src="" alt="" /><button class="dialog-close" type="button" aria-label={t.accessibility.close}>{t.accessibility.close}</button></div></dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
    const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
    const closeButton = document.querySelector<HTMLButtonElement>('.dialog-close');
    document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !dialogImage) return;
        const image = button.querySelector<HTMLImageElement>('img');
        dialogImage.src = image?.currentSrc || image?.src || '';
        dialogImage.alt = button.dataset.galleryAlt ?? 'DECK 97 image';
        dialog.showModal();
      });
    });
    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>
